<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp" android:background="@drawable/widget_background">
 <TextView android:id="@+id/widget_region" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="◈ Liyue · Nham" android:textColor="#E6BD6A" android:textSize="10sp"/>
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sổ tay của bạn" android:textColor="#F5EAD4" android:textSize="17sp" android:textStyle="bold" android:layout_marginTop="5dp" android:maxLines="1"/>
 <TextView android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0% tiến độ" android:textSize="10sp" android:textColor="#B9C6CD" android:layout_marginTop="7dp"/>
 <ProgressBar android:id="@+id/widget_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:progressTint="#E6BD6A" android:progressBackgroundTint="#3D4850" android:layout_marginTop="5dp"/>
 <TextView android:id="@+id/widget_task1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#ECE4D6" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="10dp"/>
 <TextView android:id="@+id/widget_task2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#ECE4D6" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="6dp"/>
 <TextView android:id="@+id/widget_task3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#ECE4D6" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="6dp"/>
 <TextView android:id="@+id/widget_sync" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="#91A3B0" android:layout_marginTop="8dp"/>
</LinearLayout>
